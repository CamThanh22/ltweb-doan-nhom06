Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\. - [R=404,L]
RewriteRule ^(?:database|logs)/.*\.(sql|log)$ - [F,L,NC]
RewriteRule ^(pages|inc|src|vendor|database|logs|storage|tests|kiemtra)(/|$) - [R=404,L,NC]
RewriteRule (^|/)(api\.http|router\.php)$ - [R=404,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^[^/]+\.php$ index.php [END]
</IfModule>
<FilesMatch "(?i)^(composer\.(json|lock)|.*\.(sql|log|bak|ini|lock))$">
Require all denied
</FilesMatch>
<IfModule !mod_rewrite.c>
<FilesMatch "(?i)^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>
</IfModule>
